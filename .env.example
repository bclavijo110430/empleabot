# ============================================================
# Proveedor de inferencia local
# LLM_PROVIDER=freellmapi -> router FreeLLMAPI (puerto 3001)
# LLM_PROVIDER=ollama     -> servidor Ollama (puerto 11434)
# ============================================================
LLM_PROVIDER=freellmapi

# ============================================================
# FreeLLMAPI (implementación local)
# Arranca tu router local y copia el token unificado del dashboard.
# El modelo "auto" deja que el router elija el mejor proveedor.
# ============================================================
FREELM_BASE_URL=http://localhost:3001/v1
FREELM_API_KEY=freellmapi-tu-token-unificado
FREELM_MODEL=auto
FREELM_TIMEOUT=60
FREELM_MAX_RETRIES=3

# ============================================================
# Ollama (inferencia local, solo si LLM_PROVIDER=ollama)
# Instala Ollama y descarga un modelo: `ollama pull qwen2.5:7b`
# La API key la ignora Ollama, pero el cliente OpenAI la exige.
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# ============================================================
# Navegador
# ============================================================
HEADLESS=false
SLOW_MO=0
MIN_DELAY=1.2
MAX_DELAY=4.0
ACTION_TIMEOUT_MS=20000

# ============================================================
# Búsqueda en LinkedIn
# ============================================================
SEARCH_QUERY=pmo, gestion de proyectos, compras, logistica
SEARCH_LOCATION=España
REMOTE=true
EASY_APPLY_ONLY=true

# ============================================================
# Sesión de LinkedIn (opcional)
# Vía A: login manual automático la primera vez (recomendado).
#        Deja vacías estas variables y aparecerá una ventana para
#        iniciar sesión; la sesión se reutiliza después.
# Vía B: login automático con credenciales (puede fallar con 2FA).
# LINKEDIN_EMAIL=tu.email@example.com
# LINKEDIN_PASSWORD=tu-contraseña
# Vía C: importar cookies de un JSON (extensión Cookie-Editor o
#        EditThisCookie, o un storage_state de Playwright).
# LINKEDIN_COOKIES_FILE=data/sessions/cookies.json
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_COOKIES_FILE=

# ============================================================
# Límites de seguridad (anti-bloqueo)
# ============================================================
MAX_APPLICATIONS=25
MAX_FORM_STEPS=12

# ============================================================
# Expectativa salarial (puede ser USD o COP)
# Ejemplos: EXPECTED_SALARY=1000  SALARY_CURRENCY=USD
#           EXPECTED_SALARY=4500000  SALARY_CURRENCY=COP
# ============================================================
EXPECTED_SALARY=1000
SALARY_CURRENCY=USD
SALARY_PERIOD=mensual
